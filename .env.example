# Copy this to .env and fill it in. Git ignores .env, since it can hold your Tailscale
# auth key.

# The AnyConnect server, as you'd type it into Cisco Secure Client.
VPN_SERVER=vpn.example.com
# The name on the status page.
VPN_NAME=Example VPN
# The container's name on the tailnet. Its status page is http://<TS_HOSTNAME>/.
TS_HOSTNAME=example-vpn

# full: all traffic from devices using the exit node goes into the VPN, internet included.
# split: only the networks the VPN claims go into it; the rest uses this host's connection.
ROUTE_MODE=full

# Optional: DNS servers to use instead of the VPN's, separated by spaces. The VPN's
# internal names then don't resolve.
# DNS_SERVERS=1.1.1.1 8.8.8.8

# tailscaled's port, published on the Docker host. Change it only if it's in use.
TS_PORT=41642
# Optional: the Docker host's LAN address, announced with that port, so devices on the
# LAN connect directly (README.md). Leave it out on a laptop that changes networks.
# TS_LAN_ADDRESS=192.168.1.10

# Optional: a Tailscale auth key, so the first start doesn't need the login URL.
# TS_AUTHKEY=tskey-auth-...

# Connect on start, and reconnect when a session ends.
AUTO_CONNECT=true
TZ=UTC
